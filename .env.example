# ==========================================
# Pure Roots - Environment Variables Template
# Copy this file to .env.local for local testing.
# In production, add these in the HostSeba panel (Webuzo/cPanel) or in
# Vercel Project Settings -> Environment Variables.
#
# NEVER commit a filled .env.local or real secrets.
# ==========================================

# 1. Canonical public URL (no trailing slash). Required in production.
# Used for canonical metadata, Open Graph, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://purerootbd.shop

# 2. Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# 3. Supabase anon / publishable key (safe for browser code)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# 4. Supabase service-role key (server-only; NEVER expose to the browser)
# Also accepted as SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY

# 5. Admin Dashboard master password (20+ random characters; enforced in
# production). The password is checked server-side, then an emailed OTP is
# required before the HttpOnly session cookie is issued. Never put this value in
# client code or NEXT_PUBLIC_* variables.
ADMIN_PASSWORD=your_strong_admin_password

# Optional: session backend. "stateless" is automatic on Vercel (signed cookie
# that works across serverless instances). "memory" is the default elsewhere
# and gives immediate logout revocation, but requires a single Node process.
# ADMIN_SESSION_MODE=memory
#
# Required in production: a dedicated 32+ character HMAC secret, different from
# ADMIN_PASSWORD and ADMIN_OTP_HASH_SECRET. Development falls back to
# ADMIN_PASSWORD; production refuses to use a short or shared secret.
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace_with_32_plus_random_characters

# 6. Admin email OTP (required: password alone no longer grants a session)
# Create the key at https://resend.com/api-keys. Server-only — never prefix it
# with NEXT_PUBLIC_ or put it in client code.
RESEND_API_KEY=re_your_resend_api_key
#
# Must be an address on a domain verified in Resend (not a Gmail address).
# Example: PureRoots <no-reply@mail.purerootbd.shop>
RESEND_FROM_EMAIL="PureRoots Admin <no-reply@your-verified-domain.com>"
#
# Comma-separated allowlist. Both addresses get the same code; either can
# verify it. Read server-side only — never from a request. Put the real
# addresses in .env.local / hosting, not in this committed template.
ADMIN_OTP_RECIPIENTS=admin-one@example.com,admin-two@example.com
#
# Optional tuning (defaults shown):
# ADMIN_OTP_TTL_SECONDS=300
# ADMIN_OTP_MAX_ATTEMPTS=5
# ADMIN_OTP_RESEND_COOLDOWN_SECONDS=60
# ADMIN_OTP_MAX_RESENDS=3
#
# Required in production: a dedicated 32+ character HMAC secret for OTP hashes,
# different from ADMIN_PASSWORD and ADMIN_SESSION_SECRET. Development falls back
# to ADMIN_SESSION_SECRET / ADMIN_PASSWORD. Rotating it invalidates pending codes.
# Generate with: openssl rand -hex 32
ADMIN_OTP_HASH_SECRET=replace_with_a_different_32_plus_random_value
#
# Challenge storage: "supabase" is the default and is required on Vercel
# (run supabase/migrations/20261029120000_admin_login_challenges.sql first).
# "memory" is only for local tests / a single long-running Node process; it is
# refused on Vercel.
ADMIN_OTP_STORE=supabase
#
# LOCAL TESTS ONLY. Redirects Resend calls to RESEND_API_BASE_URL and is ignored
# when VERCEL=1. Never enable in production.
# ADMIN_OTP_TEST_MODE=1
# RESEND_API_BASE_URL=http://127.0.0.1:3999

# -----------------------------------------------------------------
# HostSeba / self-hosted Node only (not needed on Vercel)
# -----------------------------------------------------------------
# NODE_ENV=production
# PORT=3000
# HOST=0.0.0.0
#
# Some panels proxy to 127.0.0.1. If the app is reachable only from the
# panel's local proxy, set HOST=127.0.0.1. Otherwise leave HOST unset.
#
# SECURITY: NEVER set NODE_TLS_REJECT_UNAUTHORIZED=0 in production.
# It disables TLS certificate verification and exposes all outbound
# connections (including Supabase) to man-in-the-middle attacks.
# Always keep it unset (defaults to 1 / certificate verification on).
