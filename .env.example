# ==========================================
# Pure Roots - Environment Variables Template
# Copy this file to .env.local for local testing
# Or add these keys in Vercel Project Settings -> Environment Variables
# ==========================================

# 1. Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# 2. Supabase Anon / Publishable Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# 3. Supabase Service Role Key (Keep private! Never expose to browser)
# Also accepted as SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY

# 4. Admin Dashboard Master Password
ADMIN_PASSWORD=your_strong_admin_password

